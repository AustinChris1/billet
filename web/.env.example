# Default Tempo network for new invoices: tempo (mainnet) or moderato (testnet). Issuers can switch per invoice.
VITE_CHAIN=tempo
# Sample billet link fragments (#t=...&p=...), comma separated; the first one runs live in the landing hero
# VITE_SAMPLE_LINKS="t=...&p=zdp:1:..."   (quote it: dotenv treats # as a comment)
# gRPC-web lightwalletd proxies, tried in order
# VITE_LIGHTWALLETD=https://zcash-mainnet.chainsafe.dev,https://zjs.zec.rocks/mainnet
