+        account_name: &str,
+        seed_phrase: &str,
+        account_hd_index: u32,
+        birthday_height: Option<u32>,
+    ) -> Result<u32, Error> {
+        tracing::info!("Create account called");
+        self.inner
+            .create_account(
+                account_name,
+                seed_phrase,
+                account_hd_index,
+                birthday_height,
+                None,
+            )
+            .await
+            .map(|id| *id)
+    }
